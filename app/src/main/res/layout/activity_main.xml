<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Header Vermelho -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:cardCornerRadius="0dp"
        android:elevation="4dp"
        app:cardBackgroundColor="#12CD0C">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/imgLogo"
android:layout_width="40dp"
                        android:layout_height="40dp"
                android:src="@drawable/ic_logo_header"
                android:scaleType="centerInside" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnProfile"
                android:layout_width="43dp"
                android:layout_height="43dp"
                android:src="@drawable/ic_profile"
                android:background="@android:color/transparent"
                android:tint="#FFFFFF"
                android:scaleType="centerInside"
                android:padding="1dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Barra de Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvNovosCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Novos Pedidos"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none"
                    android:layout_marginHorizontal="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical" />
                </HorizontalScrollView>

            <Button
                android:id="@+id/btnFiltrar"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Filtrar"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_red"
                app:backgroundTint="@null"
                android:drawableStart="@drawable/ic_filter_slider"
                android:drawableTint="@color/white"
                android:drawablePadding="5dp"
                android:paddingHorizontal="14dp"
                android:stateListAnimator="@null"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#666666"
            android:textStyle="normal"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_subtitle"
            android:layout_marginTop="4dp" />

        <!-- Tabs da aba PRONTO PARA RETIRADA -->
        <HorizontalScrollView
            android:id="@+id/layoutTabsRetirada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tabRetiradaGeral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GERAL"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#666666"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:background="@drawable/bg_tab_retirada_unselected"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tabRetiradaColetaTardia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COLETA TARDIA (0)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#666666"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:background="@drawable/bg_tab_retirada_unselected"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tabRetiradaEmAnalise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EM ANÁLISE (0)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#666666"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:background="@drawable/bg_tab_retirada_unselected"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tabRetiradaParado3Dias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+3 DIAS PARADO (0)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#666666"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:background="@drawable/bg_tab_retirada_unselected"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Linha de busca e filtros da aba PRONTO PARA RETIRADA -->
        <LinearLayout
            android:id="@+id/layoutBuscaRetirada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#F4F4F4"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/etBuscaRetirada"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="2"
                android:hint="Busque por número do pedido ou nome do cliente"
                android:textSize="14sp"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:background="@drawable/bg_select_input"
                android:drawableEnd="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:paddingHorizontal="12dp"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionSearch" />

            <Spinner
                android:id="@+id/spinnerCanalRetirada"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_select_input"
                android:spinnerMode="dropdown" />

            <Spinner
                android:id="@+id/spinnerOrigemRetirada"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_select_input"
                android:spinnerMode="dropdown" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

    <!-- Loading -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:background="@color/background_light">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carregando pedidos..."
            android:textSize="14sp"
            android:textColor="@color/gray_soft"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:background="#F8F9FA"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imgEmptyIllustration"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/ic_receipt"
            android:background="@drawable/bg_circle_gray_light"
            android:scaleType="centerInside"
            android:padding="28dp"
            android:alpha="1.0" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Não há pedidos!"
            android:textSize="22sp"
            android:textColor="#1A1A1A"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />
    </LinearLayout>

    <!-- Lista de pedidos com SwipeRefresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPedidos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background_light"
            android:clipToPadding="false"
            android:padding="8dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Histórico (inicialmente oculto) -->
    <LinearLayout
        android:id="@+id/layoutHistorico"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#f4f7f6">

        <!-- Barra de Pesquisa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etBuscarHistorico"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:hint="Pesquisar no histórico..."
                android:textSize="14sp"
                android:textColor="#1A1A1A"
                android:textColorHint="#999999"
                android:background="@drawable/bg_busca"
                android:paddingHorizontal="12dp"
                android:imeOptions="actionSearch"
                android:inputType="text" />

            <ImageButton
                android:id="@+id/btnLimparBusca"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_fechar"
                android:background="@android:color/transparent"
                android:tint="#1A1A1A"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:layout_marginStart="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Badges de filtro 3x2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:background="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/btnFiltroTodos"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="TODOS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_filter_todos" />

                <TextView
                    android:id="@+id/btnFiltroPegueLoja"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="PEGUE NA LOJA"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_filter_pegue" />

                <TextView
                    android:id="@+id/btnFiltroDelivery"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="DELIVERY"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_filter_delivery" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnFiltroIfood"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="IFOOD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_filter_ifood" />

                <TextView
                    android:id="@+id/btnFiltroCancelado"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="CANCELADO"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_filter_cancelado" />

                <TextView
                    android:id="@+id/btnFiltroDevolvido"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="DEVOLVIDO"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_filter_devolvido" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E7EB" />

        <!-- Loading do histórico -->
        <LinearLayout
            android:id="@+id/layoutHistoricoLoading"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#6B7280" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carregando histórico..."
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Empty state do histórico -->
        <LinearLayout
            android:id="@+id/layoutHistoricoEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="24dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_historico"
                android:alpha="0.3" />

            <TextView
                android:id="@+id/tvHistoricoEmptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nenhum pedido no histórico"
                android:textSize="16sp"
                android:textColor="#6B7280"
                android:layout_marginTop="16dp"
                android:textAlignment="center" />
        </LinearLayout>

        <!-- Lista do histórico -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistorico"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false" />
    </LinearLayout>
    </LinearLayout>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="8dp"
        android:clipChildren="false"
        android:outlineProvider="none">

        <LinearLayout
            android:id="@+id/tabNovo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:clipChildren="false">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/imgIconNovo"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_clipboard"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/tvQtdNovo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#000000"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_badge_count_green"
                    android:minWidth="16dp"
                    android:minHeight="16dp"
                    android:paddingHorizontal="3dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-8dp"
                    android:layout_marginEnd="-10dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvLabelNovo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Novos"
                android:textColor="#12CD0C"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSeparacao"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:clipChildren="false">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/imgIconSeparacao"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_sync"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/tvQtdSeparacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#000000"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_badge_count_blue"
                    android:minWidth="16dp"
                    android:minHeight="16dp"
                    android:paddingHorizontal="3dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-8dp"
                    android:layout_marginEnd="-10dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvLabelSeparacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Separação"
                android:textColor="#00CBFE"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabRetirada"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:clipChildren="false">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/imgIconRetirada"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_bag"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/tvQtdPronto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#000000"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_badge_count_orange"
                    android:minWidth="16dp"
                    android:minHeight="16dp"
                    android:paddingHorizontal="3dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-8dp"
                    android:layout_marginEnd="-10dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvLabelRetirada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retirada"
                android:textColor="#FFAA02"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabEntrega"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:clipChildren="false">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/imgIconEntrega"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_truck"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/tvQtdEntrega"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#000000"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_badge_count_purple"
                    android:minWidth="16dp"
                    android:minHeight="16dp"
                    android:paddingHorizontal="3dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-8dp"
                    android:layout_marginEnd="-10dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvLabelEntrega"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entrega"
                android:textColor="#CE00FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabEstoque"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:clipChildren="false">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/imgIconEstoque"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_estoque"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/tvQtdEstoque"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#000000"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_badge_count_red"
                    android:minWidth="16dp"
                    android:minHeight="16dp"
                    android:paddingHorizontal="3dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-8dp"
                    android:layout_marginEnd="-10dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvLabelEstoque"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estoque"
                android:textColor="#B62F2C"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabHistorico"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:clipChildren="false">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/imgIconHistorico"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_historico"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/tvQtdHistorico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#000000"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_badge_count_gray"
                    android:minWidth="16dp"
                    android:minHeight="16dp"
                    android:paddingHorizontal="3dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-8dp"
                    android:layout_marginEnd="-10dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvLabelHistorico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Histórico"
                android:textColor="#7F8C8D"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
