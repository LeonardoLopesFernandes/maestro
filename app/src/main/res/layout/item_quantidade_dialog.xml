<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    android:paddingHorizontal="4dp"
    android:background="#FAFAFA"
    android:layout_marginVertical="2dp"
    android:gravity="center_vertical">

    <!-- Checkbox -->
    <CheckBox
        android:id="@+id/cbItemSelecionado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp" />

    <!-- Quantidade Pediu -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvQuantidadeOriginal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1x"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:minWidth="32dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Descrição + SKU + Estoque -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvDescricaoItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Produto"
            android:textSize="14sp"
            android:textColor="#333333"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvCodigoSap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EAN: 000000 / SAP: 000000"
            android:textSize="11sp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/tvEstoqueBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estoque estimado: 0"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_green"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginTop="4dp"
            android:gravity="center" />

        <!-- ✅ IMEI - FICA VISÍVEL QUANDO O ITEM É SELECIONADO E PRECISA DE IMEI -->
        <LinearLayout
            android:id="@+id/layoutImeis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvImeiLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IMEI(s) do Item:"
                android:textSize="11sp"
                android:textColor="#D32F2F"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:gravity="center" />

            <EditText
                android:id="@+id/etImei1"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:inputType="number"
                android:textSize="12sp"
                android:textColor="#333333"
                android:gravity="center"
                android:background="@drawable/bg_input_quantidade"
                android:padding="4dp"
                android:maxLength="15"
                android:hint="Digite o IMEI 1"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etImei2"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:inputType="number"
                android:textSize="12sp"
                android:textColor="#333333"
                android:gravity="center"
                android:background="@drawable/bg_input_quantidade"
                android:padding="4dp"
                android:maxLength="15"
                android:hint="Digite o IMEI 2"
                android:layout_marginTop="4dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quantidade Confirmar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qtde"
            android:textSize="10sp"
            android:textColor="#999999"
            android:textStyle="bold"
            android:layout_marginBottom="1dp" />

        <EditText
            android:id="@+id/etQuantidade"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:inputType="number"
            android:text="1"
            android:textSize="16sp"
            android:textColor="#333333"
            android:gravity="center"
            android:background="@drawable/bg_input_quantidade"
            android:padding="4dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/tvStatusDisponivel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disponível"
            android:textSize="11sp"
            android:textColor="#12CD0C"
            android:layout_marginTop="4dp"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>