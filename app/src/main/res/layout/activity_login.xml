<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E60000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <TextView
        android:id="@+id/txtFundoGigante"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="M"
        android:textColor="#99111111"
        android:textSize="310sp"
        android:alpha="0.12"
        android:includeFontPadding="false"
        android:scaleX="6.0"
        android:scaleY="6.0"
        android:translationX="200dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.75" />

    <!-- 1. Área do Logo e Título -->
    <LinearLayout
        android:id="@+id/headerLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/containerLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.42">

        <ImageView
            android:id="@+id/logoGrande"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_maestro_logo"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="maestro"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="0dp"
            android:alpha="0.0" />

        <TextView
            android:id="@+id/tvDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gerencie todos os seus pedidos"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:alpha="0.0" />
    </LinearLayout>

    <!-- 2. Formulário -->
    <LinearLayout
        android:id="@+id/containerLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="20dp"
        android:alpha="0.0"
        app:layout_constraintTop_toBottomOf="@id/headerLogin"
        app:layout_constraintBottom_toTopOf="@id/btnSalvarCredenciais"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- E-mail -->
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="E-mail institucional"
                android:textSize="16sp"
                android:textColor="#0056B3"
                android:textColorHint="#70B7D0"
                android:inputType="textEmailAddress"
                android:background="@drawable/bg_input_login_reference"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center_vertical"
                android:importantForAutofill="no" />

            <!-- Senha -->
            <EditText
                android:id="@+id/etSenha"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="15dp"
                android:hint="Senha"
                android:textSize="16sp"
                android:textColor="#0056B3"
                android:textColorHint="#70B7D0"
                android:inputType="textPassword"
                android:background="@drawable/bg_input_login_reference"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:gravity="center_vertical"
                android:importantForAutofill="no" />

            <!-- Botão ENTRAR -->
            <Button
                android:id="@+id/btnEntrar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="40dp"
                android:text="ENTRAR"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_entrar_login"
                app:backgroundTint="@null"
                android:stateListAnimator="@null" />

            <!-- Divisor "ou" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#55FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ou"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:paddingHorizontal="10dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#55FFFFFF" />
            </LinearLayout>

            <!-- Botão Microsoft -->
            <Button
                android:id="@+id/btnMicrosoft"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="ENTRAR COM MICROSOFT"
                android:textSize="14sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="#333333"
                android:background="@drawable/bg_btn_microsoft_login"
                app:cornerRadius="8dp"
                android:textAllCaps="false"
                app:icon="@drawable/ic_microsoft"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@null" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. Checkbox de Salvar Credenciais -->
    <LinearLayout
        android:id="@+id/btnSalvarCredenciais"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:alpha="0.0"
        app:layout_constraintTop_toBottomOf="@id/containerLogin"
        app:layout_constraintBottom_toTopOf="@id/tvVersao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgCheckboxLogin"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_checkbox_unchecked"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Salvar credenciais e ativar login automático"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 4. Rodapé de versão -->
    <TextView
        android:id="@+id/tvVersao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:paddingHorizontal="24dp"
        android:text="versão 1.6.2 (62)"
        android:textColor="#FFCCCC"
        android:textSize="14sp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
