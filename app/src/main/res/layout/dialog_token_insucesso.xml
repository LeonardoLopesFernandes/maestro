<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="20dp">

    <!-- Divisor superior -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="20dp" />

    <!-- Código de Retirada em destaque -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_code_highlight"
        android:padding="16dp"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check_circle"
            android:contentDescription="Válido"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Código de retirada:"
            android:textSize="15sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tvTokenInsucesso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:gravity="end"
            android:maxLines="1"
            android:text="----" />
    </LinearLayout>

    <!-- Instruções -->
    <TextView
        android:id="@+id/tvInstrucao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Informe o código para o entregador e aguarde a validação para liberar o pedido."
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="20dp" />

    <!-- Status 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_status_item"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/imgStatusValidacao"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_spinner_ring"
            android:contentDescription="Status validação"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Validação do código de retirada"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tvStatusValidacaoDetalhe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aguardando o entregador"
                android:textSize="12sp"
                android:textColor="#999999"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Status 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_status_item"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imgStatusLiberado"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_spinner_ring"
            android:contentDescription="Status liberação"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pedido liberado para entrega"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tvStatusLiberadoDetalhe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aguardando validação"
                android:textSize="12sp"
                android:textColor="#999999"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Ajuda/SAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp">

        <LinearLayout
            android:id="@+id/layoutAjudaHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Se houver problemas na validação ou na retirada do pacote, entre em contato com o SAL."
                android:textSize="13sp"
                android:textColor="#666666"
                android:lineSpacingExtra="1dp" />

            <ImageView
                android:id="@+id/imgSetaAjuda"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_arrow_down"
                android:contentDescription="Expandir"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutAjudaBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WhatsApp: (11) 99149-2204"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Segunda a Sexta, das 09h às 21h Sábado, das 09h as 19h."
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divisor inferior -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp" />

    <!-- Rodapé -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/btnFechar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="FECHAR"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#B32645"
            android:background="@drawable/bg_btn_close_outline"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnConfirmarRetirada"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="CONFIRMAR RETIRADA"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#999999"
            android:background="@drawable/bg_btn_confirm_disabled"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:enabled="false" />
    </LinearLayout>

</LinearLayout>