<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_item_card_smartphone"
    android:orientation="vertical"
    android:padding="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbItemSelecionado"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:checked="true"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:id="@+id/tvQuantidadeOriginal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="3x"
                android:textColor="#212121"
                android:textSize="18sp"
                android:textStyle="bold"
                android:minWidth="40dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDescricaoItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Produto"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCodigoSap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="EAN: 000000 / SAP: 000000"
                android:textColor="#616161"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEstoqueBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_estoque_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Estoque estimado: 0"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qtde"
            android:textColor="#616161"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/ibQtdMinus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_stepper_grey"
            android:contentDescription="Diminuir quantidade"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_down"
            android:tint="#FFFFFF"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/etQuantidade"
            android:layout_width="60dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_qtde"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:importantForAutofill="no"
            android:inputType="number"
            android:text="0"
            android:textColor="#212121"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/dividerImeis"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#E0E0E0"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutImeis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvImeiLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="IMEI(s) do Item:"
            android:textColor="#E6243B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutImeiContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

</LinearLayout>