<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema Base do App (Light Mode) -->
    <style name="Theme.Maestro" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Status Bar com cor do Toolbar -->
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Cores principais -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Cores de superfície -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black_text</item>
        
        <!-- Cor do texto padrão -->
        <item name="android:textColor">@color/black_text</item>
        
        <!-- Toolbar / ActionBar -->
        <item name="android:actionBarStyle">@style/Theme.Maestro.ActionBar</item>
        <item name="actionBarStyle">@style/Theme.Maestro.ActionBar</item>
        
        <!-- Cor do fundo dos dialogs -->
        <item name="android:dialogTheme">@style/Theme.Maestro.Dialog</item>
        
        <!-- Cor do bottom sheet -->
        <item name="android:colorBackground">@color/white</item>
        <item name="android:colorPrimary">@color/colorPrimary</item>
        
        <!-- Fontes -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Estilo da ActionBar (caso use) -->
    <style name="Theme.Maestro.ActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="android:background">@color/colorPrimary</item>
        <item name="android:titleTextColor">@color/white</item>
        <item name="android:subtitleTextColor">@color/white</item>
    </style>

    <!-- Estilo para Dialogs (Light) -->
    <style name="Theme.Maestro.Dialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="android:textColor">@color/black_text</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorSurface">@color/white</item>
    </style>

    <!-- Estilo do Dialog de Perfil (transparente, sem bordas) -->
    <style name="DialogPerfilTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>